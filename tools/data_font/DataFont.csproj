<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <StartupObject>CCDataFont.Host</StartupObject>
    <ToolDir>$(MSBuildThisFileDirectory)..\..\work\tools\UTMT_CLI_v0.9.2.0-Windows</ToolDir>
    <NoWarn>CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../data_noop/Program.cs" Link="NoopHost.cs" />
    <Compile Include="../../data_noop_core.cs" Link="data_noop_core.cs" />
    <Compile Include="../../data_font_core.cs" Link="data_font_core.cs" />
    <Compile Include="../../font_builder_core.cs" Link="font_builder_core.cs" />
    <Compile Include="../../font_builder_io.cs" Link="font_builder_io.cs" />
    <Compile Include="../../font_atlas_core.cs" Link="font_atlas_core.cs" />
    <Compile Include="../../font_atlas_io.cs" Link="font_atlas_io.cs" />
    <Compile Include="../../font_atlas_umt.cs" Link="font_atlas_umt.cs" />
    <Compile Include="../../font_atlas_bz2qoi.cs" Link="font_atlas_bz2qoi.cs" />
    <Reference Include="UndertaleModLib"><HintPath>$(ToolDir)\UndertaleModLib.dll</HintPath></Reference>
    <Reference Include="Underanalyzer"><HintPath>$(ToolDir)\Underanalyzer.dll</HintPath></Reference>
    <Reference Include="Magick.NET-Q8-AnyCPU"><HintPath>$(ToolDir)\Magick.NET-Q8-AnyCPU.dll</HintPath></Reference>
    <Reference Include="Magick.NET.Core"><HintPath>$(ToolDir)\Magick.NET.Core.dll</HintPath></Reference>
    <Reference Include="ICSharpCode.SharpZipLib"><HintPath>$(ToolDir)\ICSharpCode.SharpZipLib.dll</HintPath></Reference>
  </ItemGroup>
</Project>
